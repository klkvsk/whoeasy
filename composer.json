{
  "name": "klkvsk/whoeasy",
  "type": "library",
  "description": "Easily lookup domain names, IP addresses and AS numbers by WHOIS and RDAP.",
  "keywords": [
    "whoisparser",
    "whois",
    "rdap",
    "php"
  ],
  "homepage": "https://github.com/klkvsk/whoeasy",
  "author": "Misha Kulakovsky",
  "license": "Apache-2.0",
  "bin": [
    "bin/whoeasy"
  ],
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "files": [
      "src/functions.php"
    ],
    "psr-4": {
      "Klkvsk\\Whoeasy\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Klkvsk\\Whoeasy\\Tests\\": "tests/"
    }
  }
}
