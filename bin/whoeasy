#!/usr/bin/env php
<?php
require $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

use Klkvsk\Whoeasy\Whoeasy;
use Klkvsk\Whoeasy\Config;
use Klkvsk\Whoeasy\QueryOptions;
use Klkvsk\Whoeasy\Enum\QueryMode;

set_error_handler(
    fn($severity, $msg, $file = null, $line = null) => new ErrorException($msg, 0, $severity, $file, $line),
    E_ALL
);
error_reporting(E_ALL);

return new class($argv) {

    protected bool $verbose;

    const FLAGS = [
        'v' => 'verbose',
        'h' => 'help',
    ];
    const OPTIONS = [
        's' => 'server',
        'f' => 'format',
        'p' => 'proxy',
        'm' => 'mode',
    ];

    public function __construct(
        protected array $argv
    )
    {
        $args = $this->parseArgs();

        if ($args['help']) {
            $this->printUsage();
            exit(0);
        }
        $this->verbose = $args['verbose'];
        try {
            $server = $args['server'];
            if ($server) {
                fwrite(STDERR, "Warning: manual server override not yet supported, ignoring -s/--server\n");
            }

            $proxyAddress = $args['proxy'];

            $modeStr = $args['mode'] ?? null;
            $mode = null;
            if ($modeStr !== null) {
                $mode = QueryMode::tryFrom($modeStr);
                if ($mode === null) {
                    throw new InvalidArgumentException(
                        'Unknown mode: ' . $modeStr
                        . '. Valid modes: ' . implode(', ', array_map(fn($m) => $m->value, QueryMode::cases()))
                    );
                }
            }

            $format = $args['format'] ?? 'result';
            $target = $args[0] ?? null;
            if (!$target) {
                throw new InvalidArgumentException('Target query is not specified');
            }

            $config = new Config(
                defaultMode: $mode ?? QueryMode::PreferRdap,
                proxyUri: $proxyAddress,
            );
            $whoeasy = Whoeasy::create($config);
            $options = new QueryOptions(
                mode: $mode,
                proxyUri: $proxyAddress,
            );

            $result = $whoeasy->query($target, $options);

            if ($this->verbose) {
                $actualMode = $mode ?? $config->defaultMode;
                fwrite(STDERR, '## mode:   ' . $actualMode->value . "\n");
                fwrite(STDERR, '## query:  ' . $result->query . "\n");
                if ($result->whoisHops) {
                    fwrite(STDERR, '## whois:  ' . $result->whoisHops[0]->server . "\n");
                }
                if ($result->rdapHops) {
                    fwrite(STDERR, '## rdap:   ' . $result->rdapHops[0]->server . "\n");
                }
                if ($proxyAddress) {
                    fwrite(STDERR, '## proxy:  ' . $proxyAddress . "\n");
                }
            }

            $output = match ($format) {
                'r', 'result' => json_encode(
                    $result->result->toArray(),
                    JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR
                ),
                'w', 'raw' => $this->getRawText($result),
                'j', 'json' => $this->getRdapJson($result),
                default => throw new InvalidArgumentException('Unknown format: ' . $format),
            };

            echo $output . PHP_EOL;

        } catch (\InvalidArgumentException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            $this->printUsage();
            exit(2);
        } catch (\Throwable $e) {
            fwrite(STDERR, $e::class . ': ' . $e->getMessage() . PHP_EOL);
            if ($this->verbose) {
                fwrite(STDERR, $e->getTraceAsString() . PHP_EOL);
            }
            exit(1);
        }
    }

    private function getRawText(\Klkvsk\Whoeasy\Result\QueryResult $result): string
    {
        if ($result->whoisHops) {
            return $result->whoisHops[0]->text;
        }
        if ($result->rdapHops) {
            return $result->rdapHops[0]->text;
        }
        return '(no raw response available)';
    }

    private function getRdapJson(\Klkvsk\Whoeasy\Result\QueryResult $result): string
    {
        if ($result->rdapHops && $result->rdapHops[0]->json !== null) {
            return json_encode(
                $result->rdapHops[0]->json,
                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR
            );
        }
        if ($result->whoisHops) {
            return '(no RDAP JSON available, only WHOIS raw text)';
        }
        return '(no RDAP JSON available)';
    }

    public function printUsage(): void
    {
        echo "\nUsage:\n";
        echo "  whoeasy [options] <domain|ip|asn>\n";
        echo "\n";
        echo "Options:\n";
        echo "  -s, --server <server>    use specified whois server (not yet supported)\n";
        echo "  -p, --proxy <uri>        proxy address (SOCKS5/HTTP)\n";
        echo "  -f, --format <format>    output format (default: result)\n";
        echo "  -m, --mode <mode>        query mode (default: prefer-rdap)\n";
        echo "  -v, --verbose            show debug output and traces\n";
        echo "  -h, --help               show this message\n";
        echo "\n";
        echo "Formats:\n";
        echo "  r, result   structured result as JSON [default]\n";
        echo "  w, raw      raw WHOIS/RDAP response text\n";
        echo "  j, json     raw RDAP JSON response\n";
        echo "\n";
        echo "Modes:\n";
        echo "  prefer-rdap    try RDAP first, fall back to WHOIS [default]\n";
        echo "  prefer-whois   try WHOIS first, fall back to RDAP\n";
        echo "  rdap-only      RDAP only\n";
        echo "  whois-only     WHOIS only\n";
        echo "  both           query both and merge results\n";
    }

    public function parseArgs(): array
    {
        $shorts = '';
        $longs = [];
        foreach (self::FLAGS as $short => $long) {
            $shorts .= $short;
            $longs[] = $long;
        }
        foreach (self::OPTIONS as $short => $long) {
            $shorts .= $short . ":";
            $longs[] = $long . ":";
        }
        $opt = getopt($shorts, $longs);
        $result = [];
        $args = $this->argv;
        array_shift($args);
        foreach (self::FLAGS as $short => $long) {
            $result[$long] = isset($opt[$short]) || isset($opt[$long]);
            $args = array_filter($args, fn($arg) => $arg !== "-$short" && $arg !== "--$long");
        }
        foreach (self::OPTIONS as $short => $long) {
            $value = $opt[$short] ?? $opt[$long] ?? null;
            $result[$long] = $value;
            $args = array_filter($args, fn($arg) => $arg !== "-$short" && $arg !== "--$long" && $arg !== $value);
        }
        foreach ($args as $arg) {
            $result[] = $arg;
        }
        return $result;
    }

};
