#!/usr/bin/env php
<?php
require $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

use Klkvsk\Whoeasy\QueryMode;
use Klkvsk\Whoeasy\Whoeasy;
use Klkvsk\Whoeasy\QueryOptions;
use Psr\Log\AbstractLogger;
use Psr\Log\LogLevel;

set_error_handler(
        fn($severity, $msg, $file = null, $line = null) => new ErrorException($msg, 0, $severity, $file, $line),
        E_ALL,
);
error_reporting(E_ALL);

return new class($argv) {

    const FLAGS = [
            'h' => 'help',
            'F' => 'full',
            'r' => 'recursive',
    ];
    const OPTIONS = [
            's' => 'server',
            'p' => 'proxy',
            'm' => 'mode',
    ];
    // Long flags that negate a flag (--no-recursive sets recursive=false)
    const NEGATED_FLAGS = [
            'no-recursive' => 'recursive',
    ];
    // Verbosity levels mapped by flag name
    const VERBOSITY_FLAGS = [
            'verbose' => LogLevel::INFO,
            'debug'   => LogLevel::DEBUG,
    ];

    /** @var array<string, int> */
    private const LOG_LEVEL_PRIORITY = [
        LogLevel::DEBUG     => 0,
        LogLevel::INFO      => 1,
        LogLevel::NOTICE    => 2,
        LogLevel::WARNING   => 3,
        LogLevel::ERROR     => 4,
        LogLevel::CRITICAL  => 5,
        LogLevel::ALERT     => 6,
        LogLevel::EMERGENCY => 7,
    ];

    public function __construct(
            protected array $argv,
    )
    {
        $args = $this->parseArgs();

        if ($args['help']) {
            $this->printUsage();
            exit(0);
        }
        try {
            $server = $args['server'];
            if ($server) {
                fwrite(STDERR, "Warning: manual server override not yet supported, ignoring -s/--server\n");
            }

            $proxyAddress = $args['proxy'];

            $modeStr = $args['mode'] ?? null;
            $mode = QueryOptions::DEFAULT_MODE;
            if ($modeStr !== null) {
                $mode = QueryMode::tryFrom($modeStr);
                if ($mode === null) {
                    throw new InvalidArgumentException(
                            'Unknown mode: ' . $modeStr
                            . '. Valid modes: ' . implode(', ', array_map(fn($m) => $m->value, QueryMode::cases())),
                    );
                }
            }

            $target = $args[0] ?? null;
            if (!$target) {
                throw new InvalidArgumentException('Target query is not specified');
            }

            $logLevel = $args['_logLevel'] ?? LogLevel::WARNING;
            $logger = $this->createLogger($logLevel);

            $whoeasy = Whoeasy::create(logger: $logger);

            $recursive = $args['recursive'] ?? QueryOptions::DEFAULT_RECURSIVE;

            $result = $whoeasy->query(
                    $target,
                    new QueryOptions(
                            mode: $mode,
                            proxyUri: $proxyAddress,
                            recursive: $recursive,
                    ),
            );

            $outputData = $args['full']
                    ? $result->toArray()
                    : ($result->info?->toArray());

            if (!$outputData) {
                if ($result->isNotFound()) {
                    echo "Not found" . PHP_EOL;
                } else if ($result->hasRetryableErrors()) {
                    echo "Retryable error" . PHP_EOL;
                } else {
                    echo "Error" . PHP_EOL;
                }
            } else {
                echo json_encode(
                                $outputData,
                                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR,
                        ) . PHP_EOL;
            }

        } catch (\InvalidArgumentException $e) {
            fwrite(STDERR, $e->getMessage() . PHP_EOL);
            $this->printUsage();
            exit(2);
        } catch (\Throwable $e) {
            fwrite(STDERR, $e::class . ': ' . $e->getMessage() . PHP_EOL);
            if (($args['_logLevel'] ?? LogLevel::WARNING) === LogLevel::DEBUG) {
                fwrite(STDERR, $e->getTraceAsString() . PHP_EOL);
            }
            exit(1);
        }
    }

    private function createLogger(string $minLevel): AbstractLogger
    {
        $minPriority = self::LOG_LEVEL_PRIORITY[$minLevel] ?? 3;

        return new class($minPriority) extends AbstractLogger {
            /** @param int $minPriority */
            public function __construct(private int $minPriority) {}

            /** @param array<mixed> $context */
            public function log($level, string|\Stringable $message, array $context = []): void
            {
                $levelStr = is_string($level) ? $level : LogLevel::INFO;
                $priority = [
                    LogLevel::DEBUG => 0, LogLevel::INFO => 1, LogLevel::NOTICE => 2,
                    LogLevel::WARNING => 3, LogLevel::ERROR => 4, LogLevel::CRITICAL => 5,
                    LogLevel::ALERT => 6, LogLevel::EMERGENCY => 7,
                ][$levelStr] ?? 3;

                if ($priority < $this->minPriority) {
                    return;
                }

                $msg = (string)$message;
                // Replace {key} placeholders with context values
                foreach ($context as $key => $val) {
                    if (is_string($key) && (is_string($val) || is_numeric($val))) {
                        $msg = str_replace('{' . $key . '}', (string)$val, $msg);
                    }
                }

                foreach (explode("\n", $msg) as $line) {
                    fwrite(STDERR, "# $line\n");
                }
            }
        };
    }

    public function printUsage(): void
    {
        echo "\nUsage:\n";
        echo "  whoeasy [options] <domain|ip|asn>\n";
        echo "\n";
        echo "Options:\n";
        echo "  -s, --server <server>    use specified whois server (not yet supported)\n";
        echo "  -p, --proxy <uri>        proxy address (SOCKS5/HTTP)\n";
        echo "  -m, --mode <mode>        query mode (default: prefer-rdap)\n";
        echo "  -r, --recursive          follow referrals [default]\n";
        echo "      --no-recursive       do not follow referrals\n";
        echo "  -F, --full               output full result with hops (default: info only)\n";
        echo "  -v, --verbose            show info-level log output\n";
        echo "  -vv, --debug             show debug-level log output (includes raw responses)\n";
        echo "  -h, --help               show this message\n";
        echo "\n";
        echo "Modes:\n";
        echo "  prefer-rdap    try RDAP first, fall back to WHOIS [default]\n";
        echo "  prefer-whois   try WHOIS first, fall back to RDAP\n";
        echo "  rdap-only      RDAP only\n";
        echo "  whois-only     WHOIS only\n";
        echo "  both           query both and merge results\n";
    }

    public function parseArgs(): array
    {
        $result = [];

        // Initialize defaults
        foreach (self::FLAGS as $short => $long) {
            $result[$long] = false;
        }
        // recursive is special: null = use default, true = -r, false = --no-recursive
        $result['recursive'] = null;
        foreach (self::OPTIONS as $short => $long) {
            $result[$long] = null;
        }

        $args = $this->argv;
        array_shift($args); // remove script name

        $positional = [];
        $verbosityCount = 0;
        $i = 0;
        while ($i < count($args)) {
            $arg = $args[$i];

            // Long option
            if (str_starts_with($arg, '--')) {
                $name = substr($arg, 2);
                // Check flags
                $flagKey = array_search($name, self::FLAGS, true);
                if ($flagKey !== false) {
                    $result[$name] = true;
                    $i++;
                    continue;
                }
                // Check verbosity flags
                if (isset(self::VERBOSITY_FLAGS[$name])) {
                    $result['_logLevel'] = self::VERBOSITY_FLAGS[$name];
                    $i++;
                    continue;
                }
                // Check negated flags (--no-recursive etc.)
                if (isset(self::NEGATED_FLAGS[$name])) {
                    $result[self::NEGATED_FLAGS[$name]] = false;
                    $i++;
                    continue;
                }
                // Check options (with value)
                $optKey = array_search($name, self::OPTIONS, true);
                if ($optKey !== false) {
                    $result[$name] = $args[++$i] ?? null;
                    $i++;
                    continue;
                }
                throw new InvalidArgumentException("Unknown option: $arg");
            }

            // Short option(s)
            if (str_starts_with($arg, '-') && strlen($arg) > 1) {
                $chars = substr($arg, 1);
                for ($j = 0; $j < strlen($chars); $j++) {
                    $ch = $chars[$j];
                    if ($ch === 'v') {
                        $verbosityCount++;
                    } elseif (isset(self::FLAGS[$ch])) {
                        $result[self::FLAGS[$ch]] = true;
                    } elseif (isset(self::OPTIONS[$ch])) {
                        // Value is rest of this arg or next arg
                        $rest = substr($chars, $j + 1);
                        if ($rest !== '') {
                            $result[self::OPTIONS[$ch]] = $rest;
                        } else {
                            $result[self::OPTIONS[$ch]] = $args[++$i] ?? null;
                        }
                        break; // consumed rest of short opts
                    } else {
                        throw new InvalidArgumentException("Unknown option: -$ch");
                    }
                }
                $i++;
                continue;
            }

            // Positional
            $positional[] = $arg;
            $i++;
        }

        // Map verbosity count to log level
        if ($verbosityCount > 0) {
            $result['_logLevel'] = $verbosityCount >= 2 ? LogLevel::DEBUG : LogLevel::INFO;
        }

        foreach ($positional as $idx => $val) {
            $result[$idx] = $val;
        }

        return $result;
    }

};
